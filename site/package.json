{
  "name": "spectre-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync-tracks": "node scripts/sync-tracks.mjs",
    "predev": "node scripts/sync-tracks.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-tracks.mjs",
    "build": "next build",
    "export": "SPECTRE_EXPORT=1 npm run build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "export:preview": "NEXT_PUBLIC_SPECTRE_PREVIEW=1 npm run export && node scripts/preview-export.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
