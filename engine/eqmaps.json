{
  "_about": "Per-genre EQ maps for `studio.py listen --clarity` (engine/clarity.py): for each role, the high-pass point (`hp`: [lo, hi] Hz, the range the map gives), optional low-pass (`lp`), regions to cut or control (`cut`) and regions the role owns (`own`), all in Hz, with the source of each map in `source` (the genre doc's 'Layering and EQ carving' section, where every row has its own citation). Ranges are starting points ('there are no specific frequencies that will always work', Mike Senior, Sound On Sound 2008). `core` lists the roles a peak section is expected to fill (alternatives joined by |); `tolerance_db` is how far a stem's level per 1/3 octave in a cut region may exceed its level in its own region before it is flagged (hand-tuned: 6 dB where the genre carves, 9 dB in acoustic genres, where orchestration and balance come first and EQ moves are light); `inherit` borrows the map of another genre for roles this one does not list. Roles: sub, 808, kick, bass, upper-bass, lead, support, air, pluck, arp, pad, keys, organ, strings, low-strings, choir, vocal, guitar, acoustic, bells, brass, snare, clap, hats, cymbals, perc, texture, fx, return.",
  "_aliases": {"trance_radio": "trance", "trap": "hiphop"},
  "trance": {
    "source": "docs/TRANCE.md 'Modern trance production', B: the professional trance producer's EQ map [P], checked against iZotope, Attack Magazine, Sound On Sound, NI, Cold Rush",
    "tolerance_db": 6,
    "core": ["kick", "sub", "bass|upper-bass", "lead", "pad|support|strings|choir", "clap|snare", "hats", "air"],
    "roles": {
      "kick": {"hp": [20, 30], "cut": [[200, 500]], "own": [[45, 80], [2000, 5000]]},
      "sub": {"hp": [20, 30], "lp": [80, 120], "own": [[40, 90]]},
      "bass": {"hp": [90, 150], "cut": [[200, 350]], "own": [[150, 250], [700, 2000]]},
      "upper-bass": {"hp": [180, 250], "cut": [[300, 500]], "own": [[800, 3000]]},
      "lead": {"hp": [120, 200], "cut": [[250, 400]], "own": [[1000, 4000]]},
      "support": {"hp": [200, 350], "cut": [[300, 600]], "own": [[2000, 6000]]},
      "air": {"hp": [500, 1000], "cut": [[3000, 5000]], "own": [[8000, 14000]]},
      "pluck": {"hp": [150, 300], "cut": [[250, 500]], "own": [[2000, 5000]]},
      "arp": {"hp": [200, 400], "cut": [[300, 600]], "own": [[2000, 8000]]},
      "pad": {"hp": [150, 300], "cut": [[200, 500]], "own": [[1000, 3000], [8000, 12000]]},
      "keys": {"hp": [100, 200], "cut": [[200, 400]], "own": [[2000, 5000]]},
      "strings": {"hp": [150, 250], "cut": [[300, 600]], "own": [[2000, 4000]]},
      "choir": {"hp": [150, 250], "cut": [[300, 600]], "own": [[2000, 4000]]},
      "vocal": {"hp": [80, 120], "cut": [[200, 400], [5000, 9000]], "own": [[2000, 5000], [10000, 15000]]},
      "clap": {"hp": [120, 200], "cut": [[400, 800]], "own": [[2000, 8000]]},
      "snare": {"hp": [120, 200], "cut": [[400, 800]], "own": [[2000, 8000]]},
      "hats": {"hp": [500, 2000], "cut": [[5000, 8000]], "own": [[8000, 14000]]},
      "cymbals": {"hp": [500, 2000], "cut": [[5000, 8000]], "own": [[8000, 14000]]},
      "fx": {"hp": [150, 400]},
      "return": {"hp": [200, 500], "lp": [6000, 12000], "cut": [[300, 600]]}
    }
